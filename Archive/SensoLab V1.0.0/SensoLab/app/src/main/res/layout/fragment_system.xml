<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBackground" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ TEXTUAL ═══ -->
        <LinearLayout android:id="@+id/sys_layout_textual"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🌡️  Temperature" android:textColor="?attr/colorPrimary"
                android:textSize="15sp" android:textStyle="bold" android:paddingBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="12dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_battery_temp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="🔋 Battery\nTemp\n-- °C"
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp"
                        android:fontFamily="monospace" android:gravity="center" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_cpu_temp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="🔥 CPU\nTemp\n-- °C"
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp"
                        android:fontFamily="monospace" android:gravity="center" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_gpu_temp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="🎮 GPU\nTemp\n-- °C"
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp"
                        android:fontFamily="monospace" android:gravity="center" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="📋  Device Specs" android:textColor="?attr/colorPrimary"
                android:textSize="15sp" android:textStyle="bold" android:paddingBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_device_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="📱 Device\n--" android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_android" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="🤖 Android\n--" android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_cpu" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="⚡ CPU\n--" android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_ram" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="💾 RAM\n--" android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_storage" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="🗂 Storage\n--" android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="4dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/tv_screen" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="📺 Screen\n--" android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <TextView android:id="@+id/tv_abi" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="12dp"
                    android:text="🔧 Architecture: --" android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" android:fontFamily="monospace"/>
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🏁  Benchmark" android:textColor="?attr/colorPrimary"
                android:textSize="15sp" android:textStyle="bold" android:paddingBottom="8dp"/>

            <Button android:id="@+id/btn_benchmark"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="▶  Run Benchmark" android:textSize="15sp"
                android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <ProgressBar android:id="@+id/pb_benchmark"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="20dp"
                app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
                <TextView android:id="@+id/tv_bench_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="14dp"
                    android:text="Press ▶ Run Benchmark to start.\nTests: Integer • Float • Memory • Multi-Core"
                    android:textColor="?attr/colorOnSurface" android:textSize="12sp"
                    android:fontFamily="monospace" android:lineSpacingExtra="4dp"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ═══ VISUAL ═══ -->
        <LinearLayout android:id="@+id/sys_layout_visual"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🌡️  Temperature" android:textColor="?attr/colorPrimary"
                android:textSize="15sp" android:textStyle="bold" android:paddingBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="12dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/vis_batt_temp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="14dp"
                        android:text="🟢\n--°C\n--%"
                        android:textSize="18sp" android:gravity="center"
                        android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:lineSpacingExtra="4dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/vis_cpu_temp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="14dp"
                        android:text="🔥\n--°C"
                        android:textSize="22sp" android:gravity="center"
                        android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:lineSpacingExtra="4dp"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                    <TextView android:id="@+id/vis_gpu_temp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="14dp"
                        android:text="🎮\n--°C"
                        android:textSize="22sp" android:gravity="center"
                        android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:lineSpacingExtra="4dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="📋  Device" android:textColor="?attr/colorPrimary"
                android:textSize="15sp" android:textStyle="bold" android:paddingBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <TextView android:id="@+id/vis_device" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="16dp"
                    android:text="📱\n--" android:textSize="16sp" android:gravity="center"
                    android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:lineSpacingExtra="4dp"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/vis_ram" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="💾\n--"
                            android:textSize="16sp" android:gravity="center"
                            android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp"/>
                        <ProgressBar android:id="@+id/pb_vis_ram" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent" android:layout_height="10dp"
                            android:layout_marginTop="8dp" android:max="100" android:progress="0"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="5dp"
                    app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TextView android:id="@+id/vis_storage" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="🗂\n--"
                            android:textSize="16sp" android:gravity="center"
                            android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="3dp"/>
                        <ProgressBar android:id="@+id/pb_vis_storage" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent" android:layout_height="10dp"
                            android:layout_marginTop="8dp" android:max="100" android:progress="0"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

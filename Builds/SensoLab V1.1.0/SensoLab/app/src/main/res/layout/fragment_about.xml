<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBackground" android:padding="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📡" android:textSize="72sp"
            android:paddingTop="16dp" android:paddingBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SensoLab" android:textColor="?attr/colorPrimary"
            android:textSize="30sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="v1.1.0  •  com.sensolab.devicemonitor"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
            android:paddingBottom="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Device Sensor Monitor &amp; Hardware Analyzer"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp"
            android:paddingBottom="20dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="14dp"
            app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="About SensoLab" android:textColor="?attr/colorPrimary"
                    android:textSize="15sp" android:textStyle="bold" android:paddingBottom="10dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="SensoLab gives you full real-time visibility into your device's hardware.\n\n✅  17 live hardware sensors\n✅  8 thermal zones (CPU, GPU, Battery, Modem, WiFi, Charger, NPU, Skin)\n✅  Full device specifications &amp; export to file\n✅  Multi-phase performance benchmark\n✅  GPS speed &amp; altitude tracking\n✅  Live compass + sound-level meter\n✅  Textual &amp; Visual display modes\n✅  Metric / Imperial units\n✅  Dark &amp; Light themes"
                    android:textColor="?attr/colorOnSurface" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btn_rate" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="⭐  Rate on Google Play"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_donate" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="❤️  Support Development"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_share" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="📤  Share with Friends"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_email" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="✉️  Feedback &amp; Support"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Made with ❤️  for Android enthusiasts"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:paddingBottom="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="© 2026 SensoLab" android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" android:paddingBottom="20dp"/>
    </LinearLayout>
</ScrollView>

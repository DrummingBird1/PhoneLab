<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBackground" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hw_section_cpu"
            android:textColor="?attr/colorPrimary" android:textSize="14sp"
            android:textStyle="bold" android:paddingBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
            <TextView android:id="@+id/tv_hw_cpu" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="14dp"
                android:text="—" android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hw_section_battery"
            android:textColor="?attr/colorPrimary" android:textSize="14sp"
            android:textStyle="bold" android:paddingBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
            <TextView android:id="@+id/tv_hw_battery" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="14dp"
                android:text="—" android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hw_section_display"
            android:textColor="?attr/colorPrimary" android:textSize="14sp"
            android:textStyle="bold" android:paddingBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
            <TextView android:id="@+id/tv_hw_display" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="14dp"
                android:text="—" android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hw_section_capabilities"
            android:textColor="?attr/colorPrimary" android:textSize="14sp"
            android:textStyle="bold" android:paddingBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
            <TextView android:id="@+id/tv_hw_caps" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="14dp"
                android:text="—" android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PhoneLab.ScreenScroll">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/hw_section_battery" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_batt_level" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_battery" app:sensorTitle="@string/hw_batt_level" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_batt_health" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_heart" app:sensorTitle="@string/hw_batt_health" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_batt_power" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_charger" app:sensorTitle="@string/hw_batt_power" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_batt_capacity" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_battery" app:sensorTitle="@string/hw_batt_capacity" />
    </GridLayout>

    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hw_batt_history_title"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardLabel" />
            <com.sensolab.devicemonitor.SparklineView
                android:id="@+id/spark_batt_history"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/tv_batt_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardUnit" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/hw_section_cpu" />
    <com.sensolab.devicemonitor.SensorCardView
        android:id="@+id/card_cpu_freq"
        style="@style/Widget.PhoneLab.WideCard"
        app:sensorIcon="@drawable/ic_chip"
        app:sensorTitle="@string/hw_cpu_peak" />

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/hw_section_display" />
    <com.sensolab.devicemonitor.SensorCardView
        android:id="@+id/card_display"
        style="@style/Widget.PhoneLab.WideCard"
        app:sensorIcon="@drawable/ic_screen"
        app:sensorTitle="@string/hw_disp_current" />

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/hw_section_capabilities" />
    <com.sensolab.devicemonitor.SensorCardView
        android:id="@+id/card_caps"
        style="@style/Widget.PhoneLab.WideCard"
        app:sensorIcon="@drawable/ic_device"
        app:sensorTitle="@string/hw_section_capabilities" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>

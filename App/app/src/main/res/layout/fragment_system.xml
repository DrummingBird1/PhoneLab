<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PhoneLab.ScreenScroll">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

<!-- ══════════════ TEXTUAL ══════════════ -->
<LinearLayout
    android:id="@+id/sys_layout_textual"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/system_section_temps" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_batt_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_battery" app:sensorTitle="@string/temp_battery" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_cpu_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_chip" app:sensorTitle="@string/temp_cpu" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_gpu_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_gpu" app:sensorTitle="@string/temp_gpu" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_skin_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_device" app:sensorTitle="@string/temp_skin" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_modem_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_modem" app:sensorTitle="@string/temp_modem" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_wifi_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_wifi" app:sensorTitle="@string/temp_wifi" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_charger_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_charger" app:sensorTitle="@string/temp_charger" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_npu_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_chip" app:sensorTitle="@string/temp_npu" />
    </GridLayout>

    <!-- Batch 7: CPU temperature trend from the ring buffer in SystemViewModel -->
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/system_cpu_trend"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardLabel" />
            <com.sensolab.devicemonitor.SparklineView
                android:id="@+id/spark_cpu_temp"
                android:layout_width="match_parent"
                android:layout_height="56dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/system_section_specs" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_device" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_device" app:sensorTitle="@string/spec_device" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_android" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_tab_system" app:sensorTitle="@string/spec_android_title" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_cpu" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_chip" app:sensorTitle="@string/spec_cpu" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_ram" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_chip" app:sensorTitle="@string/spec_ram" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_storage" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_storage" app:sensorTitle="@string/spec_storage" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_screen" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_screen" app:sensorTitle="@string/spec_screen" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_gpu" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_gpu" app:sensorTitle="@string/spec_gpu" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_abi" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_chip" app:sensorTitle="@string/spec_abi_title" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/system_section_benchmark" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_benchmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_btn_run_benchmark"
                app:icon="@drawable/ic_play" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_benchmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tv_bench_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingExtra="3dp"
                android:text="@string/system_benchmark_intro"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardDetail" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/system_bench_trend"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardLabel" />
            <com.sensolab.devicemonitor.SparklineView
                android:id="@+id/spark_bench_history"
                android:layout_width="match_parent"
                android:layout_height="56dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/system_section_export" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_btn_export"
                app:icon="@drawable/ic_share" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_json"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_btn_export_json"
                app:icon="@drawable/ic_share" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_specs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_btn_copy" />
            <TextView
                android:id="@+id/tv_export_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingTop="4dp"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardUnit" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

<!-- ══════════════ VISUAL ══════════════ -->
<LinearLayout
    android:id="@+id/sys_layout_visual"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/system_section_temps_short" />
    <GridLayout style="@style/Widget.PhoneLab.Grid" android:columnCount="@integer/gauge_grid_columns">
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_batt_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_battery" app:sensorTitle="@string/temp_battery"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="80" app:gaugeWarn="40" app:gaugeHot="45" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_cpu_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_chip" app:sensorTitle="@string/temp_cpu"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="110" app:gaugeWarn="45" app:gaugeHot="65" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_gpu_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_gpu" app:sensorTitle="@string/temp_gpu"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="110" app:gaugeWarn="45" app:gaugeHot="65" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_skin_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_device" app:sensorTitle="@string/temp_skin"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="80" app:gaugeWarn="40" app:gaugeHot="48" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/system_section_device" />
    <com.sensolab.devicemonitor.SensorCardView
        android:id="@+id/card_vis_device"
        style="@style/Widget.PhoneLab.WideCard"
        app:sensorIcon="@drawable/ic_device"
        app:sensorTitle="@string/spec_device" />
    <GridLayout style="@style/Widget.PhoneLab.Grid" android:columnCount="@integer/gauge_grid_columns">
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_ram" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_chip" app:sensorTitle="@string/spec_ram"
            app:gaugeType="bar" app:gaugeMin="0" app:gaugeMax="100" app:gaugeWarn="80" app:gaugeHot="92" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_storage" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_storage" app:sensorTitle="@string/spec_storage"
            app:gaugeType="bar" app:gaugeMin="0" app:gaugeMax="100" app:gaugeWarn="85" app:gaugeHot="95" />
    </GridLayout>
</LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PhoneLab.ScreenScroll">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ═══ Appearance ═══ -->
    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/settings_section_appearance" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tv_theme_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_theme"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_dynamic_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_dynamic_color"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_language"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_app_language"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ Display mode ═══ -->
    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/settings_section_display_mode" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tv_mode_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_display_mode"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ Units ═══ -->
    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/settings_section_units" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tv_units_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainerHighest"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:text="@string/settings_units_reference"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardUnit" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_units"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ Thermal alerts ═══ -->
    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/settings_section_thermal" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tv_thermal_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_thermal_alerts"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ Custom sensor alerts ═══ -->
    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/settings_section_alerts" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_alerts_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            <LinearLayout
                android:id="@+id/alert_rules_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/tv_alerts_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/settings_alerts_empty"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardUnit" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_alert"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/settings_alerts_add"
                    app:icon="@drawable/ic_add" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_check_alerts"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_alerts_check_now" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ Battery history ═══ -->
    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/settings_section_battery_history" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_battery_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_battery_history" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_battery_history_desc"
                android:textAppearance="@style/TextAppearance.PhoneLab.CardUnit" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_battery_history"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_battery_history_clear" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/settings_note"
        android:textAppearance="@style/TextAppearance.PhoneLab.CardUnit" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>

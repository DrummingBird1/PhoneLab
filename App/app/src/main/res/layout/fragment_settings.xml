<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBackground" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/settings_title" android:textColor="?attr/colorPrimary"
      android:textSize="24sp" android:textStyle="bold"
      android:paddingTop="8dp" android:paddingBottom="20dp"/>

  <!-- Theme -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="12dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_section_appearance" android:textColor="?attr/colorOnSurface"
          android:textSize="15sp" android:textStyle="bold" android:paddingBottom="4dp"/>
      <TextView android:id="@+id/tv_theme_desc"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_now_dark"
          android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
          android:paddingBottom="12dp"/>
      <Button android:id="@+id/btn_theme"
          android:layout_width="match_parent" android:layout_height="48dp"
          android:text="@string/settings_btn_to_light"
          android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Display Mode -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="12dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_section_display_mode" android:textColor="?attr/colorOnSurface"
          android:textSize="15sp" android:textStyle="bold" android:paddingBottom="4dp"/>
      <TextView android:id="@+id/tv_mode_desc"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_now_textual"
          android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
          android:paddingBottom="12dp"/>
      <Button android:id="@+id/btn_display_mode"
          android:layout_width="match_parent" android:layout_height="48dp"
          android:text="@string/settings_btn_to_visual"
          android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Unit System -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="12dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_section_units" android:textColor="?attr/colorOnSurface"
          android:textSize="15sp" android:textStyle="bold" android:paddingBottom="4dp"/>
      <TextView android:id="@+id/tv_units_desc"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_now_metric"
          android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
          android:paddingBottom="8dp"/>
      <!-- Reference card -->
      <androidx.cardview.widget.CardView android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginBottom="12dp"
          app:cardBackgroundColor="?attr/colorSurfaceVariant" app:cardCornerRadius="8dp"
          app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="@string/settings_units_reference"
              android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp"
              android:lineSpacingExtra="2dp"/>
        </LinearLayout>
      </androidx.cardview.widget.CardView>
      <Button android:id="@+id/btn_units"
          android:layout_width="match_parent" android:layout_height="48dp"
          android:text="@string/settings_btn_to_imperial"
          android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Thermal Alerts -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="12dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_section_thermal" android:textColor="?attr/colorOnSurface"
          android:textSize="15sp" android:textStyle="bold" android:paddingBottom="4dp"/>
      <TextView android:id="@+id/tv_thermal_desc"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/settings_now_thermal_on"
          android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
          android:paddingBottom="12dp"/>
      <Button android:id="@+id/btn_thermal_alerts"
          android:layout_width="match_parent" android:layout_height="48dp"
          android:text="@string/settings_btn_thermal_disable"
          android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Note -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="20dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="@string/settings_note"
        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp"
        android:lineSpacingExtra="3dp"/>
  </androidx.cardview.widget.CardView>

</LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBackground" android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

<!-- ═══════════ TEXTUAL MODE ═══════════ -->
<LinearLayout android:id="@+id/layout_textual"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

  <!-- Accel + Gyro -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_accelerometer" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Accelerometer\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_gyroscope" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Gyroscope\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Mag + Gravity -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_magnetic_field" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Magnetometer\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_gravity" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Gravity Vector\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- LinAccel + Rotation -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_linear_accel" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Linear Accel\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_rotation_vector" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Rotation Vector\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Game Rotation + Uncal Gyro -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_game_rotation" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Game Rotation\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_gyro_uncal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Gyro Uncalibrated\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Light + Pressure -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_light" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Light Sensor\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_pressure" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Barometer\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Proximity + Humidity -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_proximity" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Proximity\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_humidity" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Humidity\nNot available" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Ambient Temp + Heart Rate -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_ambient_temp" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Ambient Temp\nNot available" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_heart_rate" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Heart Rate\nNot available" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Step Detector + Step Counter -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_step_detector" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Step Detector\n🚶 0 steps" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_step_counter" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Step Counter\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Tilt + Sig Motion -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_tilt_detector" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Tilt Detector\n📱 0 tilts" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_sig_motion" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Significant Motion\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Sound Level + Altitude -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_sound_level" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="🎤 Sound Level\n-- dB" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_altitude" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="⛰️ GPS Altitude\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- GPS Speed full-width -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="10dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
    <TextView android:id="@+id/tv_speed" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="16dp"
        android:text="🚀 GPS Speed  —  0.0 km/h"
        android:textColor="?attr/colorPrimary" android:textSize="18sp"
        android:textStyle="bold" android:gravity="center"/>
  </androidx.cardview.widget.CardView>

  <!-- ═══ Advanced sensors (v1.2.0) ═══ -->
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/sensors_section_advanced"
      android:textColor="?attr/colorPrimary" android:textSize="14sp"
      android:textStyle="bold" android:paddingTop="8dp" android:paddingBottom="6dp"/>

  <!-- Stationary + Motion detect -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="6dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_stationary" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Stationary\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_motion_detect" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Motion Detect\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Accelerometer uncalibrated -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="6dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
    <TextView android:id="@+id/tv_accel_uncal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="10dp"
        android:text="Accel Uncalibrated\n--" android:textColor="?attr/colorOnSurface"
        android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
  </androidx.cardview.widget.CardView>

  <!-- Magnetometer uncalibrated -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="6dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
    <TextView android:id="@+id/tv_mag_uncal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="10dp"
        android:text="Mag Uncalibrated\n--" android:textColor="?attr/colorOnSurface"
        android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
  </androidx.cardview.widget.CardView>

  <!-- Geomagnetic rotation + Hinge angle -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_geomag_rot" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Geomag Rotation\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="10dp" app:cardElevation="2dp">
      <TextView android:id="@+id/tv_hinge_angle" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="10dp"
          android:text="Hinge Angle\n--" android:textColor="?attr/colorOnSurface"
          android:textSize="11sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- ═══ CSV Recording panel (v1.2.0) ═══ -->
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/sensors_section_recording"
      android:textColor="?attr/colorPrimary" android:textSize="14sp"
      android:textStyle="bold" android:paddingTop="4dp" android:paddingBottom="6dp"/>

  <Button android:id="@+id/btn_record"
      android:layout_width="match_parent" android:layout_height="48dp"
      android:text="@string/rec_btn_start"
      android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>

  <TextView android:id="@+id/tv_record_status"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:padding="8dp" android:text="@string/rec_status_idle"
      android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp"
      android:gravity="center" android:layout_marginBottom="20dp"/>

</LinearLayout>

<!-- ═══════════ VISUAL MODE ═══════════ -->
<LinearLayout android:id="@+id/layout_visual"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:visibility="gone">

  <!-- Live Compass full-width -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="10dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp" android:gravity="center">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/sensors_section_live_compass" android:textColor="?attr/colorPrimary"
          android:textSize="13sp" android:textStyle="bold" android:paddingBottom="8dp"/>
      <com.sensolab.devicemonitor.CompassView
          android:id="@+id/compass_view"
          android:layout_width="240dp" android:layout_height="240dp"/>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Row: Accel Gyro LinAccel -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_accel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📳\n--"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_accel" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_gyro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🌀\n--"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_gyro" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_lin_accel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="⚡\n--"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_lin_accel" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Row: Light Pressure Gravity -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_light" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="💡\n--"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_light" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_pressure" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🌡\n--"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_pressure" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_gravity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📐\n--"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_gravity" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Row: Proximity Humidity AmbTemp -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_proximity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="↔️\nFar"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_proximity" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_humidity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="💧\n--%"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_humidity" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_ambient_temp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🌡\n--"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_ambient_temp" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Row: Step Rotation Tilt -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_step" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🚶\n0 steps"
            android:textSize="14sp" android:gravity="center" android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_step" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="10000"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <TextView android:id="@+id/vis_rot" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="8dp"
          android:text="🔄\n--" android:textSize="14sp" android:gravity="center"
          android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <TextView android:id="@+id/vis_tilt" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="8dp"
          android:text="📱\n0 tilts" android:textSize="14sp" android:gravity="center"
          android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Row: Sound Heart SigMotion -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="8dp">
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="8dp" android:gravity="center">
        <TextView android:id="@+id/vis_sound" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🎤\n-- dB"
            android:textSize="14sp" android:gravity="center" android:textColor="?attr/colorOnSurface"
            android:lineSpacingExtra="2dp"/>
        <ProgressBar android:id="@+id/pb_sound" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="4dp" android:max="100"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="4dp"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <TextView android:id="@+id/vis_heart_rate" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="8dp"
          android:text="❤️\n--bpm" android:textSize="14sp" android:gravity="center"
          android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="2dp">
      <TextView android:id="@+id/vis_sig_motion" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:padding="8dp"
          android:text="🏃\n0 events" android:textSize="14sp" android:gravity="center"
          android:textColor="?attr/colorOnSurface" android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>
  </LinearLayout>

  <!-- Speed full-width -->
  <androidx.cardview.widget.CardView android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginBottom="10dp"
      app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="3dp">
    <TextView android:id="@+id/vis_speed" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="16dp"
        android:text="🚀  0.0 km/h"
        android:textColor="?attr/colorPrimary" android:textSize="22sp"
        android:textStyle="bold" android:gravity="center"/>
  </androidx.cardview.widget.CardView>

</LinearLayout>
</LinearLayout>
</ScrollView>

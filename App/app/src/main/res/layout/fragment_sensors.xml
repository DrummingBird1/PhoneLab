<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PhoneLab.ScreenScroll">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

<!-- ═══════════ TEXTUAL MODE ═══════════ -->
<LinearLayout
    android:id="@+id/layout_textual"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_motion" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_accel" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_motion" app:sensorTitle="@string/sensor_accelerometer" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_gyro" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_rotation" app:sensorTitle="@string/sensor_gyroscope" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_lin_accel" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_motion" app:sensorTitle="@string/sensor_linear_accel" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_gravity" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_gravity" app:sensorTitle="@string/sensor_gravity" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_gyro_uncal" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_rotation" app:sensorTitle="@string/sensor_gyro_uncal" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_accel_uncal" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_motion" app:sensorTitle="@string/sensor_accel_uncal" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_orientation" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_mag" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_magnet" app:sensorTitle="@string/sensor_magnetometer" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_rotation" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_compass" app:sensorTitle="@string/sensor_rotation_vector" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_game_rotation" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_rotation" app:sensorTitle="@string/sensor_game_rotation" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_geomag_rotation" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_compass" app:sensorTitle="@string/sensor_geomag_rotation" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_mag_uncal" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_magnet" app:sensorTitle="@string/sensor_mag_uncal" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_hinge" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_hinge" app:sensorTitle="@string/sensor_hinge_angle" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_environment" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_light" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_light" app:sensorTitle="@string/sensor_light" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_pressure" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_pressure" app:sensorTitle="@string/sensor_barometer" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_humidity" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_humidity" app:sensorTitle="@string/sensor_humidity" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_ambient_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_thermometer" app:sensorTitle="@string/sensor_ambient_temp" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_proximity" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_proximity" app:sensorTitle="@string/sensor_proximity" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_sound" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_mic" app:sensorTitle="@string/sensor_sound_level" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_activity" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_step_detector" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_steps" app:sensorTitle="@string/sensor_step_detector" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_step_counter" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_steps" app:sensorTitle="@string/sensor_step_counter" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_heart_rate" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_heart" app:sensorTitle="@string/sensor_heart_rate" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_tilt" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_device" app:sensorTitle="@string/sensor_tilt_detector" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_sig_motion" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_steps" app:sensorTitle="@string/sig_motion_label" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_stationary" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_device" app:sensorTitle="@string/sensor_stationary" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_motion_detect" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_motion" app:sensorTitle="@string/sensor_motion_detect" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_location" />
    <GridLayout style="@style/Widget.PhoneLab.Grid">
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_speed" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_speed" app:sensorTitle="@string/sensor_gps_speed" />
        <com.sensolab.devicemonitor.SensorCardView android:id="@+id/card_altitude" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_altitude" app:sensorTitle="@string/sensor_gps_altitude" />
    </GridLayout>
</LinearLayout>

<!-- ═══════════ VISUAL MODE ═══════════ -->
<LinearLayout
    android:id="@+id/layout_visual"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/sensors_section_live_compass"
                android:textAppearance="@style/TextAppearance.PhoneLab.SectionHeader" />
            <com.sensolab.devicemonitor.CompassView
                android:id="@+id/compass_view"
                android:layout_width="@dimen/compass_size"
                android:layout_height="@dimen/compass_size" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_motion" />
    <GridLayout style="@style/Widget.PhoneLab.Grid" android:columnCount="@integer/gauge_grid_columns">
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_accel" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_motion" app:sensorTitle="@string/sensor_accelerometer"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="5" app:gaugeWarn="2.5" app:gaugeHot="4" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_gyro" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_rotation" app:sensorTitle="@string/sensor_gyroscope"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="360" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_lin_accel" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_motion" app:sensorTitle="@string/sensor_linear_accel"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="10" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_tilt" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_gravity" app:sensorTitle="@string/gauge_tilt_title"
            app:gaugeType="bar" app:gaugeMin="0" app:gaugeMax="90" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_environment" />
    <GridLayout style="@style/Widget.PhoneLab.Grid" android:columnCount="@integer/gauge_grid_columns">
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_sound" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_mic" app:sensorTitle="@string/sensor_sound_level"
            app:gaugeType="radial" app:gaugeMin="30" app:gaugeMax="120" app:gaugeWarn="70" app:gaugeHot="85" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_light" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_light" app:sensorTitle="@string/sensor_light"
            app:gaugeType="bar" app:gaugeMin="0" app:gaugeMax="5" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_pressure" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_pressure" app:sensorTitle="@string/sensor_barometer"
            app:gaugeType="bar" app:gaugeMin="950" app:gaugeMax="1050" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_humidity" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_humidity" app:sensorTitle="@string/sensor_humidity"
            app:gaugeType="bar" app:gaugeMin="0" app:gaugeMax="100" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_ambient_temp" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_thermometer" app:sensorTitle="@string/sensor_ambient_temp"
            app:gaugeType="bar" app:gaugeMin="-10" app:gaugeMax="45" app:gaugeWarn="30" app:gaugeHot="38" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_proximity" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_proximity" app:sensorTitle="@string/sensor_proximity"
            app:gaugeType="bar" app:gaugeMin="0" app:gaugeMax="1" />
    </GridLayout>

    <TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_activity" />
    <GridLayout style="@style/Widget.PhoneLab.Grid" android:columnCount="@integer/gauge_grid_columns">
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_heart_rate" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_heart" app:sensorTitle="@string/sensor_heart_rate"
            app:gaugeType="radial" app:gaugeMin="40" app:gaugeMax="200" app:gaugeWarn="100" app:gaugeHot="140" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_steps" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_steps" app:sensorTitle="@string/sensor_step_detector"
            app:gaugeType="bar" app:gaugeMin="0" app:gaugeMax="10000" />
        <com.sensolab.devicemonitor.GaugeCardView android:id="@+id/gauge_speed" style="@style/Widget.PhoneLab.GridCard"
            app:sensorIcon="@drawable/ic_speed" app:sensorTitle="@string/sensor_gps_speed"
            app:gaugeType="radial" app:gaugeMin="0" app:gaugeMax="160" />
    </GridLayout>
</LinearLayout>

<!-- ═══════════ CSV RECORDING (both modes) ═══════════ -->
<TextView style="@style/Widget.PhoneLab.Section" android:text="@string/sensors_section_recording" />

<com.google.android.material.card.MaterialCardView style="@style/Widget.PhoneLab.WideCard">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rec_btn_start"
            app:icon="@drawable/ic_recording" />
        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/rec_status_idle"
            android:textAppearance="@style/TextAppearance.PhoneLab.CardUnit" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

</LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBackground" android:padding="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📡" android:textSize="72sp"
            android:contentDescription="@string/cd_app_icon"
            android:paddingTop="16dp" android:paddingBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="?attr/colorPrimary"
            android:textSize="30sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_version" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_version_line"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
            android:paddingBottom="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp"
            android:paddingBottom="20dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="14dp"
            app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="14dp" app:cardElevation="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/about_title" android:textColor="?attr/colorPrimary"
                    android:textSize="15sp" android:textStyle="bold" android:paddingBottom="10dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/about_body"
                    android:textColor="?attr/colorOnSurface" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btn_rate" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="@string/about_btn_rate"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_donate" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="@string/about_btn_donate"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_share" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="@string/about_btn_share"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_email" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="@string/about_btn_email"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

        <!-- Y6: hidden via Java if BuildConfig.PRIVACY_POLICY_URL is empty -->
        <Button android:id="@+id/btn_privacy" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="@string/about_btn_privacy"
            android:textSize="14sp" android:textStyle="bold"
            android:visibility="gone" android:layout_marginBottom="10dp"/>

        <View android:layout_width="wrap_content" android:layout_height="10dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/about_made_with"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" android:paddingBottom="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/about_copyright" android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" android:paddingBottom="20dp"/>
    </LinearLayout>
</ScrollView>

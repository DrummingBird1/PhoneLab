<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup + device-transfer rules for API 31+ (Android 12 and above).
  Same intent as backup_rules.xml: keep user prefs, drop exported specs.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="sensolab_prefs.xml"/>
        <exclude domain="external"   path="Documents/"/>
        <exclude domain="external"   path="PhoneLab_exports/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="sensolab_prefs.xml"/>
        <exclude domain="external"   path="Documents/"/>
        <exclude domain="external"   path="PhoneLab_exports/"/>
    </device-transfer>
</data-extraction-rules>

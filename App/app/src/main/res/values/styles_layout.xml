<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Card inside a GridLayout: equal-width columns, rows stretch to the tallest card. -->
    <style name="Widget.PhoneLab.GridCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Full-width card in a vertical LinearLayout, aligned with grid cards. -->
    <style name="Widget.PhoneLab.WideCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="Widget.PhoneLab.Grid" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:columnCount">@integer/grid_columns</item>
        <item name="android:useDefaultMargins">false</item>
    </style>

    <!-- Section title above a group of cards. -->
    <style name="Widget.PhoneLab.Section" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.PhoneLab.SectionHeader</item>
        <!-- API 28+; older versions ignore it and simply don't announce a heading. -->
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>

    <!-- Scrolling screen root: lets content scroll under the gesture bar (edge-to-edge). -->
    <style name="Widget.PhoneLab.ScreenScroll" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/colorBackground</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>
</resources>
